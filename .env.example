# Copia este archivo como ".env" y cambia los valores. El archivo .env NO se sube a Git.

# --- Base de datos ---
DB_NAME=shop_db
DB_USER=tienda
DB_PASS=cambia_esta_clave
MYSQL_ROOT_PASSWORD=cambia_la_clave_root

# --- Wompi (opcional): sin estas variables el pago en línea queda desactivado y solo hay efectivo ---
# Panel de Wompi → Desarrolladores → Llaves. Con llaves de pruebas (pub_test_…) no se cobra dinero real.
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
# Opcional: secreto de eventos, para validar también la firma del webhook (api_wompi.php)
WOMPI_EVENTS_SECRET=
# Opcional: dirección pública de la tienda (Wompi devuelve al cliente aquí). Ej.: https://papeleriaucp.up.railway.app
APP_URL=

# --- Puertos publicados en tu equipo ---
WEB_PORT=8080
PMA_PORT=8081

# Cabecera de seguridad CSP: enforce (por defecto) | report (solo avisa) | off
CSP_MODO=enforce

# Correo de confirmación de pedidos (opcional; sin SMTP_HOST no se envía nada)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Minutos para pagar un pedido en línea antes de que se cancele solo (por defecto 30)
PEDIDO_EXPIRA_MIN=30

# Copia este archivo como ".env" y cambia los valores. El archivo .env NO se sube a Git.

# --- Base de datos ---
DB_NAME=shop_db
DB_USER=tienda
DB_PASS=cambia_esta_clave
MYSQL_ROOT_PASSWORD=cambia_la_clave_root

# --- PayPal (opcional): sin estas variables el pago con tarjeta queda desactivado ---
# Crea una app en https://developer.paypal.com (usa "Sandbox" para pruebas) y copia sus credenciales.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox (pruebas) o live (cobros reales)
PAYPAL_ENV=sandbox
# PayPal no cobra en pesos: el total se convierte a USD con esta tasa (pesos por dólar).
PAYPAL_COP_PER_USD=4000

# --- Puertos publicados en tu equipo ---
WEB_PORT=8080
PMA_PORT=8081

# Tasa COP/USD automática (open.er-api.com, se guarda 6 h). Con 0 se usa siempre PAYPAL_COP_PER_USD.
PAYPAL_TASA_AUTO=1

# Cabecera de seguridad CSP: enforce (por defecto) | report (solo avisa) | off
CSP_MODO=enforce

# Correo de confirmación de pedidos (opcional; sin SMTP_HOST no se envía nada)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
